    <function model="maintenance.request" name="_techserv_create_parts_picking" eval="[[ref('intervention_invoiced')]]"/>
    <record id="intervention_invoiced" model="maintenance.request">
        <field name="stage_id" ref="maintenance.stage_3"/>
