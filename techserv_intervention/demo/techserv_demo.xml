        <field name="equipment_id" ref="equipment_bakery_generator"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="maintenance_team_id" ref="maintenance.equipment_team_maintenance"/>
        <field name="user_id" ref="user_tech2"/>
        <field name="schedule_date" eval="(DateTime.today() - relativedelta(days=3)).strftime('%Y-%m-%d 08:00:00')"/>
        <field name="schedule_end" eval="(DateTime.today() - relativedelta(days=3)).strftime('%Y-%m-%d 11:00:00')"/>
        <field name="stage_id" ref="maintenance.stage_1"/>
        <field name="time_spent">3.0</field>
        <field name="signed_by">M. Benali</field>
        <field name="signed_on" eval="(DateTime.today() - relativedelta(days=3)).strftime('%Y-%m-%d 11:00:00')"/>
        <field name="customer_signature" type="base64" file="techserv_intervention/static/img/demo_signature.png"/>
        <field name="part_ids" eval="[(0, 0, {'product_id': ref('product_part_belt'), 'quantity': 1})]"/>
