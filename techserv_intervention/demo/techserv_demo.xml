        <field name="company_id" ref="base.main_company"/>
        <field name="maintenance_team_id" ref="maintenance.equipment_team_maintenance"/>
        <field name="stage_id" ref="maintenance.stage_4"/>
        <field name="archive" eval="True"/>
    </record>

    <!-- Société Oran -->
    <record id="intervention_oran_planned" model="maintenance.request">
