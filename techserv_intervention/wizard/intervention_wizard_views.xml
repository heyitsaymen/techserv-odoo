<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Attribution groupée (menu Action de la liste des interventions) ===== -->
    <record id="techserv_intervention_plan_wizard_view_form" model="ir.ui.view">
        <field name="name">techserv.intervention.plan.wizard.form</field>
        <field name="model">techserv.intervention.plan.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Interventions">
                <group>
                    <group>
                        <field name="user_id" options="{'no_create': True}"/>
                        <field name="start_datetime"/>
                        <field name="default_duration" widget="float_time"/>
                    </group>
                </group>
                <field name="intervention_ids" readonly="1">
                    <list>
                        <field name="reference"/>
                        <field name="name"/>
                        <field name="customer_id"/>
                        <field name="priority" widget="priority"/>
                        <field name="duration" widget="float_time"/>
                        <field name="stage_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_plan" type="object" string="Assign" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_techserv_intervention_plan_wizard" model="ir.actions.act_window">
        <field name="name">Assign to a Technician</field>
        <field name="res_model">techserv.intervention.plan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- binding : l'action apparaît dans le menu « Action » de la liste -->
        <field name="binding_model_id" ref="maintenance.model_maintenance_request"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('group_techserv_manager'))]"/>
    </record>

    <!-- ===== Clôture (bouton « Clôturer » sur l'intervention) ===== -->
    <record id="techserv_intervention_close_wizard_view_form" model="ir.ui.view">
        <field name="name">techserv.intervention.close.wizard.form</field>
        <field name="model">techserv.intervention.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close the Intervention">
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="intervention_id" readonly="1"/>
                        <field name="time_spent" widget="float_time"/>
                    </group>
                </group>
                <separator string="Parts Used"/>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <separator string="Customer Signature"/>
                <group>
                    <field name="signed_by"/>
                    <field name="signature" widget="signature" options="{'full_name': 'signed_by'}"/>
                </group>
                <footer>
                    <button name="action_close" type="object" string="Close" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_techserv_intervention_close_wizard" model="ir.actions.act_window">
        <field name="name">Close the Intervention</field>
        <field name="res_model">techserv.intervention.close.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===== Facturation groupée ===== -->
    <record id="techserv_intervention_invoice_wizard_view_form" model="ir.ui.view">
        <field name="name">techserv.intervention.invoice.wizard.form</field>
        <field name="model">techserv.intervention.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice Interventions">
                <group>
                    <field name="grouping" widget="radio"/>
                </group>
                <field name="intervention_ids">
                    <list>
                        <field name="reference"/>
                        <field name="name"/>
                        <field name="customer_id"/>
                        <field name="equipment_id"/>
                        <field name="close_date"/>
                        <field name="time_spent" widget="float_time"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_invoices" type="object" string="Create Invoices" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_techserv_intervention_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Invoice Interventions</field>
        <field name="res_model">techserv.intervention.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="maintenance.model_maintenance_request"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('group_techserv_manager'))]"/>
    </record>

    <menuitem id="menu_techserv_invoice_interventions"
              name="Invoice Interventions"
              parent="maintenance.menu_m_request"
              action="action_techserv_intervention_invoice_wizard"
              groups="group_techserv_manager"
              sequence="5"/>

</odoo>
