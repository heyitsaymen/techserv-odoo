#. module: techserv_intervention
#: model:mail.template,body_html:techserv_intervention.mail_template_intervention_planned
msgid ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p>Hello <t t-out=\"object.customer_id.name or ''\">Customer</t>,</p>\n"
"    <p>\n"
"        Your intervention <strong t-out=\"object.reference or ''\">INT/2026/00001</strong>\n"
"        (<t t-out=\"object.name or ''\">Air conditioner not cooling</t>) is planned on\n"
"        <strong t-out=\"format_datetime(object.schedule_date, tz=object.customer_id.tz, dt_format='medium')\">10/20/2026 09:00</strong>.\n"
"    </p>\n"
"    <p t-if=\"object.user_id\">\n"
"        Your technician will be <t t-out=\"object.user_id.name or ''\">John</t>.\n"
"    </p>\n"
"    <p>Please keep this reference if you need to contact us.</p>\n"
"    <p>Best regards,<br/><t t-out=\"object.company_id.name or ''\">TechServ</t></p>\n"
"</div>\n"
"            "
msgstr "<div style=\"margin: 0; padding: 0;\">\n    <p>Bonjour <t t-out=\"object.customer_id.name or ''\">Client</t>,</p>\n    <p>\n        Votre intervention <strong t-out=\"object.reference or ''\">INT/2026/00001</strong>\n        (<t t-out=\"object.name or ''\">Climatiseur en panne</t>) est planifiée le\n        <strong t-out=\"format_datetime(object.schedule_date, tz=object.customer_id.tz, dt_format='medium')\">10/20/2026 09:00</strong>.\n    </p>\n    <p t-if=\"object.user_id\">\n        Votre technicien sera <t t-out=\"object.user_id.name or ''\">John</t>.\n    </p>\n    <p>Merci de conserver cette référence si vous devez nous contacter.</p>\n    <p>Cordialement,<br/><t t-out=\"object.company_id.name or ''\">TechServ</t></p>\n</div>\n            "

