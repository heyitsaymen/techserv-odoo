<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maintenance_request_view_form_inherit_techserv" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.techserv</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="techserv_state" invisible="1"/>
                <button name="action_techserv_start" type="object" string="Start"
                        class="btn-primary" invisible="techserv_state != 'planned'"/>
                <button name="%(action_techserv_intervention_close_wizard)d" type="action" string="Close"
                        class="btn-primary" invisible="techserv_state not in ('planned', 'in_progress')"
                        context="{'default_intervention_id': id}"
                        groups="techserv_intervention.group_techserv_technician"/>
            </xpath>
            <!-- Le bouton standard « Annuler » n'est proposé que tant que le technicien n'est pas parti -->
            <xpath expr="//button[@name='archive_equipment_request']" position="attributes">
                <attribute name="invisible">archive or techserv_state not in ('received', 'planned')</attribute>
                <attribute name="groups">techserv_intervention.group_techserv_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='reset_equipment_request']" position="attributes">
                <attribute name="groups">techserv_intervention.group_techserv_manager</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/label" position="before">
                <div class="text-muted fs-4" invisible="not reference">
                    <field name="reference" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='equipment_id']" position="before">
                <field name="customer_id"/>
            </xpath>
            <xpath expr="//field[@name='request_date']" position="before">
                <field name="sale_order_id" invisible="not sale_order_id"/>
                <field name="invoice_id" invisible="not invoice_id"/>
            </xpath>
            <!-- Seuls les équipements du client choisi sont proposés (=? : ignoré si pas de client) -->
            <xpath expr="//field[@name='equipment_id']" position="attributes">
                <attribute name="domain">[('customer_id', '=?', customer_id)]</attribute>
                <attribute name="context">{'default_company_id': company_id, 'default_category_id': category_id, 'default_customer_id': customer_id}</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Technician</attribute>
                <attribute name="widget">many2one_avatar_user</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Closing" name="techserv_closing" invisible="techserv_state not in ('done', 'invoiced')">
                    <group>
                        <group>
                            <field name="time_spent" widget="float_time" readonly="1"/>
                            <field name="picking_id" readonly="1" groups="stock.group_stock_user"/>
                        </group>
                        <group>
                            <field name="customer_signature" widget="image" readonly="1"
                                   options="{'size': [0, 90]}"/>
                            <field name="signed_by" readonly="1"/>
                            <field name="signed_on" readonly="1"/>
                        </group>
                    </group>
                    <field name="part_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="technician_phone" widget="phone" invisible="not technician_phone"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_request_view_list_inherit_techserv" model="ir.ui.view">
        <field name="name">maintenance.request.list.inherit.techserv</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="reference"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="customer_id"/>
                <field name="equipment_id" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="schedule_date" optional="show"/>
                <field name="duration" widget="float_time" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_request_view_kanban_inherit_techserv" model="ir.ui.view">
        <field name="name">maintenance.request.kanban.inherit.techserv</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@t-name='card']/field[@name='name']" position="before">
                <field name="reference" class="text-muted small"/>
            </xpath>
            <xpath expr="//t[@t-name='card']/field[@name='name']" position="after">
                <field name="customer_id"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_request_view_search_inherit_techserv" model="ir.ui.view">
        <field name="name">maintenance.request.search.inherit.techserv</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="reference"/>
            </xpath>
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="customer_id"/>
            </xpath>
            <xpath expr="//filter[@name='unscheduled']" position="after">
                <separator/>
                <filter string="Customer Interventions" name="techserv_customer" domain="[('customer_id', '!=', False)]"/>
                <separator/>
                <filter string="To Plan" name="techserv_to_plan" domain="[('techserv_state', '=', 'received')]"/>
                <filter string="Planned" name="techserv_planned" domain="[('techserv_state', '=', 'planned')]"/>
                <filter string="To Invoice" name="techserv_to_invoice" domain="[('techserv_state', '=', 'done')]"/>
            </xpath>
            <xpath expr="//filter[@name='assigned']" position="before">
                <filter string="Customer" name="groupby_customer" context="{'group_by': 'customer_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
