<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_inherit_techserv" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.techserv</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_interventions" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="not user_id" groups="hr.group_hr_user">
                    <field name="intervention_count" widget="statinfo" string="Interventions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
