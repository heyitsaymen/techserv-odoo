<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_techserv" model="ir.ui.view">
        <field name="name">product.template.form.inherit.techserv</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[@name='sale_option']" position="after">
                <span name="techserv_intervention_option" class="d-inline-flex">
                    <field name="create_intervention"/>
                    <label for="create_intervention"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
