<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_techserv" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.techserv</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_interventions" type="object" class="oe_stat_button"
                        icon="fa-wrench" invisible="intervention_count == 0">
                    <field name="intervention_count" widget="statinfo" string="Interventions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
