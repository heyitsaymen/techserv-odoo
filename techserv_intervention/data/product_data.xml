<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Produit service de main-d'oeuvre utilisé par la facturation
             (quantité = temps passé, prix modifiable par la comptable) -->
        <record id="product_labour" model="product.product">
            <field name="name">Labour</field>
            <field name="default_code">TS-LABOUR</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_hour"/>
            <field name="list_price">45.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>
    </data>
</odoo>
