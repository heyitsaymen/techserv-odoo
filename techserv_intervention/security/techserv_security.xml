<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 : les groupes sont rangés dans un « privilège » (res.groups.privilege),
         lui-même rattaché à une catégorie de modules. -->
    <record id="res_groups_privilege_techserv" model="res.groups.privilege">
        <field name="name">TechServ Interventions</field>
        <field name="category_id" ref="base.module_category_services_field_service"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_techserv_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_techserv"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees only the interventions assigned to him. Can start and close them, but cannot plan, cancel, delete or invoice.</field>
    </record>

    <!-- Le responsable implique le technicien, le responsable Maintenance standard
         (voit tous les équipements et demandes) et la facturation (création des factures). -->
    <record id="group_techserv_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_techserv"/>
        <field name="implied_ids" eval="[
            (4, ref('group_techserv_technician')),
            (4, ref('maintenance.group_equipment_manager')),
            (4, ref('account.group_account_invoice')),
        ]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Sees and manages all interventions: planning, cancellation, deletion and invoicing.</field>
    </record>
</odoo>
