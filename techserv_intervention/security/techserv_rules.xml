<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rappel du fonctionnement d'Odoo :
        - les droits d'accès (ir.model.access) s'ADDITIONNENT : on ne peut pas retirer
          un droit donné par un autre module. Or Maintenance donne lecture/écriture/
          création/suppression des demandes à TOUS les utilisateurs internes ;
        - les règles de GROUPE s'additionnent aussi (OU) : la règle standard « demandes
          dont je suis créateur, abonné ou technicien » resterait valable ;
        - seules les règles GLOBALES (sans groupe) se combinent en ET avec tout le reste.
        On utilise donc des règles globales dont le domaine ne restreint que les
        utilisateurs « technicien sans être responsable ». Les mêmes interdictions
        sont aussi contrôlées en Python (annuler, supprimer, facturer, planifier).
    -->
    <data noupdate="1">
        <!-- Le technicien ne voit (et ne modifie) que les interventions qui lui sont attribuées -->
        <record id="rule_request_technician_own" model="ir.rule">
            <field name="name">TechServ: technicians only access their own interventions</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[('user_id', '=', user.id)] if user.has_groups('techserv_intervention.group_techserv_technician,!techserv_intervention.group_techserv_manager') else [(1, '=', 1)]</field>
        </record>

        <!-- Le technicien ne peut supprimer aucune intervention -->
        <record id="rule_request_technician_no_unlink" model="ir.rule">
            <field name="name">TechServ: technicians cannot delete interventions</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[(0, '=', 1)] if user.has_groups('techserv_intervention.group_techserv_technician,!techserv_intervention.group_techserv_manager') else [(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Les équipements des CLIENTS sont visibles en lecture par tous les utilisateurs
             internes (commerciaux, techniciens...). La règle standard ne montre que les
             équipements suivis : elle reste valable pour le matériel interne de la société. -->
        <record id="rule_equipment_customer_read" model="ir.rule">
            <field name="name">TechServ: customer equipment readable by internal users</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[('customer_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Pièces utilisées : mêmes restrictions que l'intervention -->
        <record id="rule_part_technician_own" model="ir.rule">
            <field name="name">TechServ: technicians only access the parts of their interventions</field>
            <field name="model_id" ref="model_techserv_intervention_part"/>
            <field name="domain_force">[('intervention_id.user_id', '=', user.id)] if user.has_groups('techserv_intervention.group_techserv_technician,!techserv_intervention.group_techserv_manager') else [(1, '=', 1)]</field>
        </record>

        <!-- Multi-société pour le seul nouveau modèle (le standard couvre déjà
             maintenance.request, maintenance.equipment, ventes, factures, stock) -->
        <record id="rule_part_multi_company" model="ir.rule">
            <field name="name">TechServ: intervention parts multi-company</field>
            <field name="model_id" ref="model_techserv_intervention_part"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
