<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Le client (utilisateur portail) ne voit que les interventions de sa société
             (commercial_partner_id) ; lecture seule : la signature passe par le contrôleur. -->
        <record id="rule_request_portal_customer" model="ir.rule">
            <field name="name">TechServ: portal customers see their own interventions</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="domain_force">[('customer_id', 'child_of', [user.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
